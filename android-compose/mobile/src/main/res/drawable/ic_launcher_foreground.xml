<?xml version="1.0" encoding="utf-8"?>
<!--
  FourStreamsTV launcher mark.

  Four streams converge on one destination: the four sources the app pulls
  together, arriving at one screen. Geometry is scaled to sit inside the 66dp
  safe circle at the centre of the 108dp adaptive viewport, so no mask - circle,
  squircle or teardrop - can clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M31,37.6 Q55.6,37.6 65.5,51.5"
        android:strokeColor="#7657FF"
        android:strokeWidth="5.7"
        android:strokeLineCap="round" />
    <path
        android:pathData="M31,47.4 Q54.8,47.4 65.5,52.8"
        android:strokeColor="#9A72FF"
        android:strokeWidth="5.7"
        android:strokeLineCap="round" />
    <path
        android:pathData="M31,60.6 Q54.8,60.6 65.5,55.2"
        android:strokeColor="#4AD7F6"
        android:strokeWidth="5.7"
        android:strokeLineCap="round" />
    <path
        android:pathData="M31,70.4 Q55.6,70.4 65.5,56.5"
        android:strokeColor="#4AE08D"
        android:strokeWidth="5.7"
        android:strokeLineCap="round" />

    <!-- The destination the streams land on. -->
    <path
        android:pathData="M67.5,54 a6.2,6.2 0 1,0 12.4,0 a6.2,6.2 0 1,0 -12.4,0 z"
        android:fillColor="#F2F1F6" />
</vector>
